# ============================================================
# Compliance server — copy to `.env` and fill in your values:
#   cp .env.example .env
# Never commit `.env` (it holds secrets — it is gitignored).
# ============================================================

# --- 1. Server port (leave as-is) ---
PORT=5000

# --- 2. MongoDB connection string ---
# Atlas (recommended): Atlas → Connect → Drivers → Node.js → copy the string:
#   mongodb+srv://<db-user>:<db-password>@cluster0.xxxxx.mongodb.net/compliance?retryWrites=true&w=majority
# Local fallback (only while testing on this machine):
#   mongodb://127.0.0.1:27017/compliance
MONGO_URI=mongodb://127.0.0.1:27017/compliance

# --- 3. Public base URL of this API ---
# Used to build image URLs + PDF links. Example:
#   BASE_URL=https://<your-service>.onrender.com
# While testing locally, leave it EMPTY (server auto-uses localhost).
BASE_URL=

# --- 4. Auth ---
# Long random string. Changing it later signs out every officer
# (they just log in again).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# --- 5. Demo account passwords (used ONLY by `npm run seed`) ---
SEED_OFFICER_PASSWORD=officer123
SEED_ADMIN_PASSWORD=admin123

# --- 6. Tailscale Funnel (only for `--profile funnel`) ---
# Generate a REUSABLE auth key: https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=

# --- 7. Photo storage: Cloudinary (recommended for hosting) ---
# Free tier at cloudinary.com → Dashboard shows all three values.
# If left empty, photos stay in local `uploads/`.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
